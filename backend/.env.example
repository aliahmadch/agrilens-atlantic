# Database
POSTGRES_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/agrilens_db

# AI providers (first available in order is used; rule-based planner if none)
AGENT_PROVIDER_ORDER=gemini,groq,claude
AI_PROVIDER_ORDER=groq,gemini,claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_TOOL_CALLS=20

# Monitoring loop
AGENT_MONITOR_ENABLED=true
AGENT_MONITOR_INTERVAL_HOURS=24
AGENT_MONITOR_TICK_SECONDS=900
AGENT_MONITOR_INITIAL_DELAY_SECONDS=180

# Farmer messages
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
